{
  "name": "ark",
  "version": "0.20.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build-storybook && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fsd": "steiger ./src",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test --project=chromium --project=admin",
    "screenshots": "E2E_USE_LOCAL_SUPABASE=1 playwright test --project=screenshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o public/storybook --quiet",
    "images:resolve": "node scripts/resolve-commons.mjs",
    "credits": "tsx scripts/generate-credits.mts",
    "prepare": "husky || true",
    "db:seed:generate": "tsx scripts/generate-seed.mts",
    "db:push": "sh -c 'set -a && . ./.env.prod-secrets && supabase db push --remote -p \"$SUPABASE_DB_PASSWORD\" \"$@\"' db-push",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/shared/api/database.types.ts && prettier --write src/shared/api/database.types.ts",
    "test:e2e:local-db": "supabase db reset && E2E_USE_LOCAL_SUPABASE=1 playwright test --project=local-db",
    "db:seed:prod": "supabase db query --remote --file supabase/seed.sql",
    "size": "size-limit",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/hahmlet": "^5.3.0",
    "@radix-ui/themes": "^3.3.0",
    "@sentry/browser": "^11.12.0",
    "@ssgoi/react": "7.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "pretendard": "^1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/nextjs-vite": "10.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "steiger": "^0.9.0",
    "storybook": "10.6.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
