{
  "name": "ark",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test --project=chromium --project=admin",
    "screenshots": "playwright test --project=screenshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "images:resolve": "node scripts/resolve-commons.mjs",
    "prepare": "husky || true",
    "db:seed:generate": "tsx scripts/generate-seed.mts",
    "db:push": "supabase db push --remote"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "storybook": "10.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@12.16.1",
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
