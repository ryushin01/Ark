# 영향 아카이브(/archive)를 켭니다. 작품 이미지의 저작권을 확인하기 전까지는 비워 둡니다.
NEXT_PUBLIC_FEATURE_ARCHIVE=

# 어드민 관리자 비밀번호. 비워 두면 데모(읽기 전용) 로그인만 됩니다.
ADMIN_PASSWORD=

# 어드민 세션 서명 키. 운영 환경에서는 꼭 정합니다. 예) openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Supabase (서버 전용). 비워 두면 메모리 목업 저장소를 씁니다.
# 로컬 개발은 pnpm db:start가 출력하는 API_URL과 SECRET_KEY를 넣습니다. 운영 값을 넣지 않습니다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 운영 마이그레이션(pnpm db:push)에 쓰는 DB 비밀번호는 .env.prod-secrets에 둡니다. (여기 아님)

# Vercel Cron이 /api/keep-alive를 부를 때 확인하는 값
CRON_SECRET=
